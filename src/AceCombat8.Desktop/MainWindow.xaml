<Window x:Class="AceCombat8.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="皇牌空战8 · PXN 键位工具" Width="1280" Height="900" MinWidth="1080" MinHeight="720"
        Background="#0B1422" Foreground="#E9F0FA" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootView" Margin="28,22,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="ACE COMBAT 8  /  FLIGHT CONTROL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text="飞行控制配置" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Background="#172B39" BorderBrush="#315365" BorderThickness="1" Padding="14,10">
        <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0"/><TextBlock Text="PXN 2119 PRO" FontWeight="SemiBold"/></StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#26384E" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,20">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
          <TextBlock x:Name="FileHeading" Text="选择游戏配置" FontWeight="SemiBold" FontSize="15"/>
          <TextBox x:Name="PathDisplay" Text="自动查找，或选择 FlightStick.ini" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent" Foreground="#AFC0D6" BorderThickness="0" Padding="0" FontSize="12" Margin="0,7,0,5" TextWrapping="Wrap"/>
          <TextBlock x:Name="SteamDisplay" Text="支持自动读取 Steam 库配置，以及当前 Windows 用户的游戏配置。" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LocateButton" Content="自动查找" Click="LocateClick" Margin="0,0,8,0"/>
          <Button Content="选择文件…" Click="ChooseClick"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="238"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="Navigation">
        <TextBlock Text="控制设置" FontSize="11" Foreground="#7F94AF" Margin="10,0,0,12"/>
        <Button Tag="0" Content="01   作战按键" Click="NavigateClick" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="10,14"/>
        <Button Tag="1" Content="02   菜单导航" Click="NavigateClick" Margin="0,0,0,8" Padding="10,14"/>
        <Button Tag="2" Content="03   飞行轴" Click="NavigateClick" Margin="0,0,0,8" Padding="10,14"/>
        <Button Tag="3" Content="04   帽键与视角" Click="NavigateClick" Margin="0,0,0,8" Padding="10,14"/>
        <Button Tag="4" Content="05   备份与恢复" Click="NavigateClick" Margin="0,0,0,8" Padding="10,14"/>
        <Separator/>
        <TextBlock Text="右手：飞行摇杆&#10;左手：油门控制器" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="23" Margin="10,0,0,10"/>
        <TextBlock Text="使用 MODE 0&#10;T 连发保持 OFF" FontSize="11" Foreground="#7F94AF" LineHeight="22" Margin="10,0,0,0"/>
      </StackPanel>
      <ScrollViewer Grid.Column="2" x:Name="PageScroll" Padding="0,0,8,8"><StackPanel x:Name="ContentHost"/></ScrollViewer>
      <Border Grid.Column="4" Background="#101D2D" BorderBrush="#26384E" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="ChangesHeading" Text="待保存的更改" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="编辑后先在这里核对，再保存到游戏。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,14"/>
          <ScrollViewer Grid.Row="2"><StackPanel x:Name="ChangesHost"/></ScrollViewer>
          <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border x:Name="WarningsBox" Background="#332A1C" Padding="10" CornerRadius="6" Visibility="Collapsed"><TextBlock x:Name="WarningsText" FontSize="11" Foreground="#F4C986"/></Border>
            <TextBlock Text="每次保存都会保留原配置备份。&#10;重新启动游戏后，新的键位生效。" FontSize="11" Foreground="#7F94AF" LineHeight="20" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
        <TextBlock x:Name="StatusText" Text="正在查找游戏配置…" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="StatusDetail" Text="修改只会写入 PXN 2119 Pro 的设备区段。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ReloadButton" Content="重新读取" Click="ReloadClick" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="ExportButton" Content="导出键位表" Click="ExportClick" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="SaveButton" Content="保存到游戏" Style="{StaticResource PrimaryButton}" Padding="24,12" Click="SaveClick" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
